# ── Bite & Sips backend env ─────────────────────────────
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
DB_FILE=./data/bite-and-sips.db

# Payments (leave blank for MOCK mode — no real money moves)
# Paystack (cards + MoMo): https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# MTN MoMo (request-to-pay): https://momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_ENV=sandbox
# Frontend origin (comma-separated) for CORS
CLIENT_ORIGIN=http://localhost:5173
